# Database & Storage
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/autoapply?schema=public"
REDIS_URL="redis://localhost:6379"

# AI Provider API Keys
# Gemini API key: Get from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY="your-gemini-api-key"
# OpenRouter API key: Get from OpenRouter Settings (https://openrouter.ai/keys)
OPENROUTER_API_KEY="your-openrouter-api-key"
# Groq API key: Get from Groq Console (https://console.groq.com/keys)
GROQ_API_KEY="your-groq-api-key"
# Flag to enable dry-run offline local mock AI responses for development
USE_MOCK_AI=false

# Auth & Security
BETTER_AUTH_SECRET="your-better-auth-secret-min-32-chars"
CREDENTIAL_ENCRYPTION_KEY="your-32-byte-hex-encryption-key"

# Node Environment
NODE_ENV="development"
PORT=4000
WORKER_PORT=4001
WEB_PORT=3000

# Google OAuth Credentials
GOOGLE_CLIENT_ID="your-google-client-id"
NEXT_PUBLIC_GOOGLE_CLIENT_ID="your-google-client-id"

